{
  "name": "shared-things-daemon",
  "version": "3.0.0",
  "description": "Sync Things 3 projects between multiple macOS users",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "shared-things": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "author": "yungweng",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.1.0",
    "chalk": "^5.6.2",
    "commander": "^12.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@shared-things/common": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "tsup": "^8.5.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
